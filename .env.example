# -----------------------------------------------------------------------------
# Personal Finance Vault – environment configuration
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# -----------------------------------------------------------------------------

# Google Drive sync (Tier 2) – OAuth 2.0 "Web application" Client ID.
# Leave empty to disable Google Drive (the app then offers a simulated Drive demo).
#
# How to get one (≈5 minutes, free):
#   1. Open https://console.cloud.google.com/ and create (or select) a project.
#   2. APIs & Services → Library → search "Google Drive API" → Enable.
#   3. APIs & Services → OAuth consent screen (Google Auth Platform):
#        - User type: External, fill in app name + support email.
#        - Data access / Scopes: add `https://www.googleapis.com/auth/drive.file`
#          (non-sensitive: the app can only see files it created itself).
#        - Audience / Test users: add the Google account(s) you will sign in with
#          while the app is in "Testing" mode.
#   4. APIs & Services → Credentials → Create credentials → OAuth client ID
#        - Application type: Web application
#        - Authorized JavaScript origins (no trailing slash, no path):
#            http://localhost:5173     (npm run dev)
#            http://localhost:4173     (npm run preview)
#            https://your-domain.example (production, HTTPS required)
#        - Authorized redirect URIs: not needed (token popup flow).
#   5. Copy the "Client ID" (…apps.googleusercontent.com) below and restart Vite.
VITE_GOOGLE_CLIENT_ID=

# Optional: public base path when the app is served from a sub-directory,
# e.g. GitHub Pages project sites → /<repository-name>/
VITE_BASE_PATH=/
