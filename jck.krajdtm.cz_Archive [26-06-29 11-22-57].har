orate selection (wrap into component...)\\n\"\"\"\\ndirective @decorate(\\n  component: String!\\n  props: any\\n) repeatable on QUERY | MUTATION | SUBSCRIPTION | FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT\\n\\n\"\"\"\\nDon\\'t render subtree\\n\"\"\"\\ndirective @hidden on QUERY | MUTATION | SUBSCRIPTION | FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT | VARIABLE_DEFINITION\\n\\n\"\"\"\\nRender field as URL\\n\"\"\"\\ndirective @url(replaceHashParams: any) on FIELD\\n\\n\"\"\"\\nRender field as text\\n\"\"\"\\ndirective @text(multiline: Boolean = false) on FIELD | VARIABLE_DEFINITION\\n\\n\"\"\"\\nSpecify list length\\n\"\"\"\\ndirective @list(length: Int!) on FIELD | VARIABLE_DEFINITION | FIELD_DEFINITION\\n\\n\"\"\"\\nDirective to export value into variable.\\n\\nReferences:\\n - [RFC – Dynamic variable declaration](https://github.com/graphql/graphql-spec/issues/583)\\n - [Creating an @export GraphQL directive](https://blog.logrocket.com/creating-an-export-graphql-directive/)\\n - [GraphQL by PoP](https://graphql-by-pop.com/docs/operational/export.html)\\n\"\"\"\\ndirective @export(\\n  \"\"\"\\n  Optional name of variable to export into\\n  \"\"\"\\n  as: String\\n) on FIELD\\n\\n\"\"\"\\nOpen New Form Dialog.\\n\"\"\"\\ndirective @create(\\n  \"\"\"\\n  Route ID.\\n  \"\"\"\\n  route: String!\\n  variables: any\\n) on FIELD | VARIABLE_DEFINITION\\n\\n\"\"\"\\nOpen Detail Form\\n\"\"\"\\ndirective @detail(\\n  \"\"\"\\n  Route ID\\n  \"\"\"\\n  route: String!\\n) on FIELD | VARIABLE_DEFINITION\\n\\n\"\"\"\\nOpen History\\n\"\"\"\\ndirective @history(\\n  \"\"\"\\n  Route ID\\n  \"\"\"\\n  route: String!\\n) on FIELD\\n\\ndirective @historyTable(\\n  \"\"\"\\n  Actual Record Detail Route ID\\n  \"\"\"\\n  currentDetailRoute: String!\\n) on FIELD\\n\\n\\n\\n\"\"\"\\nGeometry type, see [WKT specification](https://en.wikipedia.org/wiki/Well-known_text_representation_of_geometry)\\n\"\"\"\\nenum _GeometryType {\\n  POINT\\n  LINESTRING\\n  POLYGON\\n  MULTIPOINT\\n  MULTILINESTRING\\n  MULTIPOLYGON\\n\\n  POINT_Z\\n  LINESTRING_Z\\n  POLYGON_Z\\n  MULTIPOINT_Z\\n  MULTILINESTRING_Z\\n  MULTIPOLYGON_Z\\n\\n  POINT_M\\n  LINESTRING_M\\n  POLYGON_M\\n  MULTIPOINT_M\\n  MULTILINESTRING_M\\n  MULTIPOLYGON_M\\n\\n  POINT_ZM\\n  LINESTRING_ZM\\n  POLYGON_ZM\\n  MULTIPOINT_ZM\\n  MULTILINESTRING_ZM\\n  MULTIPOLYGON_ZM\\n}\\n\\n\\n\\n\"\"\"\\nUse query as data source of select box\\n\"\"\"\\ndirective @select(\\n  \"\"\"\\n  Data items query\\n  \"\"\"\\n  query: String\\n\\n  \"\"\"\\n  Route ID\\n  \"\"\"\\n  route: String\\n) on VARIABLE_DEFINITION | FIELD\\n\\n\"\"\"\\nRender field value\\n\"\"\"\\ndirective @value on FIELD\\n\\n\"\"\"\\nRender edit for ewkt\\n\"\"\"\\ndirective @ewkt(\\n  \"\"\"\\n  Projection in format `EPSG:5514`\\n\\n   - EPSG:5514 - Krovak\\n   - EPSG:3857 - Web Mercator\\n   - EPSG:4326 - WGS84\\n  \"\"\"\\n  projection: String!\\n\\n  \"\"\"\\n  ID of layer from which feature should be hidden when editing\\n  \"\"\"\\n  layer: String\\n\\n  \"\"\"\\n  Geometry type for drawing, see [WKT specification](https://en.wikipedia.org/wiki/Well-known_text_representation_of_geometry)\\n  \"\"\"\\n  geometryType: _GeometryType\\n\\n  pointZoomLevel: Float\\n) on FIELD | VARIABLE_DEFINITION\\n\\ndirective @validate(min: any, max: any) on VARIABLE_DEFINITION\\n\\n\"\"\"\\nSortable by field\\n\"\"\"\\ndirective @order(\\n  \"\"\"\\n  Optional name in order filter.\\n  Default value is alias or field name.\\n  \"\"\"\\n  name: String\\n) on FIELD\\n\\n\"\"\"\\nTo visually group filters in form.\\n\"\"\"\\ndirective @group(\\n  \"\"\"\\n  ID of group\\n  \"\"\"\\n  id: String\\n) on VARIABLE_DEFINITION | FIELD | INLINE_FRAGMENT | FRAGMENT_SPREAD\\n\\n\"\"\"\\nTo identify related layer (for invalidate after mutation)\\n\"\"\"\\ndirective @layer(\\n  \"\"\"\\n  ID of layer\\n  \"\"\"\\n  id: String!\\n) on QUERY | MUTATION\\n\\nenum _ActionType {\\n  DELETE\\n  COPY\\n}\\n\\ndirective @action(mutation: String!, type: _ActionType) repeatable on FIELD\\n\\nenum _ActionType2 {\\n  DANGER\\n}\\n\\ndirective @action2(icon: String!, type: _ActionType2) on MUTATION\\n\\n\"\"\"\\nTo identify related layer (for invalidate after mutation)\\n\"\"\"\\ndirective @selectFeature(\\n  \"\"\"\\n  ID of layer\\n  \"\"\"\\n  layer: String!\\n  \"\"\"\\n  ID of data filed\\n  \"\"\"\\n  field: String!\\n) on FIELD | VARIABLE_DEFINITION\\n',name:\"GraphQL request\",locationOffset:{line:1,column:1}};var Bx={kind:\"Document\",definitions:[{kind:\"OperationDefinition\",operation:\"query\",name:{kind:\"Name\",value:\"InstalledModulesQuery\"},variableDefinitions:[{kind:\"VariableDefinition\",variable:{kind:\"Variable\",name:{kind:\"Name\",value:\"clientVersion\"}},type:{kind:\"NamedType\",name:{kind:\"Name\",value:\"auto\"}},directives:[]}],directives:[],selectionSet:{kind:\"SelectionSet\",selections:[{kind:\"Field\",name:{kind:\"Name\",value:\"installedModules\"},arguments:[{kind:\"Argument\",name:{kind:\"Name\",value:\"clientVersion\"},value:{kind:\"Variable\",name:{kind:\"Name\",value:\"clientVersion\"}}}],directives:[],selectionSet:{kind:\"SelectionSet\",selections:[{kind:\"Field\",name:{kind:\"Name\",value:\"edges\"},arguments:[],directives:[],selectionSet:{kind:\"SelectionSet\",selections:[{kind:\"Field\",name:{kind:\"Name\",value:\"node\"},arguments:[],directives:[],selectionSet:{kind:\"SelectionSet\",selections:[{kind:\"Field\",name:{kind:\"Name\",value:\"version\"},arguments:[],directives:[]},{kind:\"Field\",name:{kind:\"Name\",value:\"name\"},arguments:[],directives:[]}]}}]}}]}}]}}],loc:{start:0,end:178}};function Gx(e,t){if(\"FragmentSpread\"===e.kind)t.add(e.name.value);else if(\"VariableDefinition\"===e.kind){var n=e.type;\"NamedType\"===n.kind&&t.add(n.name.value)}e.selectionSet&&e.selectionSet.selections.forEach(function(e){Gx(e,t)}),e.variableDefinitions&&e.variableDefinitions.forEach(function(e){Gx(e,t)}),e.definitions&&e.definitions.forEach(function(e){Gx(e,t)})}Bx.loc.source={body:\"query InstalledMo