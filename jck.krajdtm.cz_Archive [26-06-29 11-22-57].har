            "text": "{\"operationName\":\"InstalledModulesQuery\",\"variables\":{},\"extensions\":{\"clientLibrary\":{\"name\":\"@apollo/client\",\"version\":\"4.1.9\"}},\"query\":\"query InstalledModulesQuery($installedModules_first: Int, $installedModules_last: Int, $installedModules_before: String, $installedModules_after: String) {\\n  installedModules(\\n    first: $installedModules_first\\n    last: $installedModules_last\\n    before: $installedModules_before\\n    after: $installedModules_after\\n  ) {\\n    edges {\\n      node {\\n        version\\n        name\\n        __typename\\n      }\\n      __typename\\n    }\\n    pageInfo {\\n      startCursor\\n      endCursor\\n      hasPreviousPage\\n      hasNextPage\\n      __typename\\n    }\\n    totalCount\\n    __typename\\n  }\\n}\"}"
