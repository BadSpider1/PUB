          "postData": {
            "mimeType": "application/json",
            "params": [],
            "text": "{\"query\":\"query configFromTinker($slugId: String!) {\\n  installedModules {\\n    edges {\\n      node {\\n        version\\n        name\\n      }\\n    }\\n  }\\n  appConfig(input: {slugId: $slugId}) {\\n    id\\n    nameId\\n    backend\\n    origin\\n    title\\n    icon\\n    slugIds\\n    baseParams\\n    requireAuth\\n    loadBeaConfig\\n    about {\\n      id\\n      nameId\\n      key\\n      value\\n    }\\n    dictionaryEntries(first: 5000) {\\n      edges {\\n        node {\\n          id\\n          nameId\\n          key\\n          value\\n        }\\n      }\\n    }\\n    routes(first: 5000) {\\n      edges {\\n        node {\\n          id\\n          nameId\\n          origin\\n          component\\n          path {\\n            default\\n            cs\\n            en\\n          }\\n          parent {\\n            id\\n            nameId\\n          }\\n          defaultSize\\n          icon\\n          isMassSelect\\n          featureLayers(first: 5000) {\\n            edges {\\n              node {\\n                id\\n                nameId\\n              }\\n            }\\n          }\\n          visibleLayers(first: 5000) {\\n            edges {\\n              node {\\n                id\\n                nameId\\n              }\\n            }\\n          }\\n        }\\n      }\\n    }\\n    category {\\n      id\\n      nameId\\n      title\\n      order\\n    }\\n    homeLink {\\n      id\\n      nameId\\n      title\\n      url\\n    }\\n    otherLinks(first: 5000) {\\n      edges {\\n        node {\\n          id\\n          nameId\\n          url\\n          title\\n        }\\n      }\\n    }\\n    maps {\\n      edges {\\n        node {\\n          id\\n          nameId\\n          maxZoom\\n          minZoom\\n          zoom\\n          center\\n          projection\\n          enableLayerSwitcherFilter\\n          enableLayerSwitcherCustomLayers\\n          enableMeasure\\n          enableExportMap\\n          enableUserLocation\\n          mapNotes\\n          enableZoomLevelShortcuts\\n          enableSearch\\n          regionCodes\\n          coordsInfo\\n          activeWidget\\n          mapSearches(first: 5000) {\\n            edges {\\n              node {\\n                id\\n                nameId\\n                title\\n                mapService {\\n                  id\\n                  nameId\\n                  schema\\n                  metadata\\n                  url\\n                  type\\n                  matrixSet\\n                  attributions\\n                  isAuth\\n                  thumbnail\\n                  geometryType\\n                  agendaIdent\\n                  mapGrid {\\n                    id\\n                    nameId\\n                    originX\\n                    originY\\n                    resolutions\\n                    extent\\n                    tileSize\\n                  }\\n                }\\n                fields {\\n                  name\\n                  title\\n                  hint\\n                  dataType\\n                  outputTemplate\\n                  listData {\\n                    title\\n                    value\\n                  }\\n                  showIn\\n                }\\n                defaultSize\\n                featureTypes\\n                minQueryLength\\n                zoomAtPoint\\n                resultsLimit\\n                order\\n                isFilled\\n                outline\\n              }\\n            }\\n          }\\n          mapInfos(first: 5000) {\\n            edges {\\n              node {\\n                id\\n                nameId\\n                title\\n                order\\n                resultsLimit\\n                mapServiceLayerId\\n                featureTypes\\n                format\\n                visibilityDependencies(first: 5000) {\\n                  edges {\\n                    n